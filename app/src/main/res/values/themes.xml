<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompatActivity requires a Theme.AppCompat descendant — a platform
        Material theme throws "You need to use a Theme.AppCompat theme" at
        setContentView. DayNight + NoActionBar keeps the system appearance
        while Compose (NexaSenseTheme) owns the actual UI theme.
    -->
    <style name="Theme.NexaSense" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
