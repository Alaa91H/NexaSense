        Compass mark, drawn inside the adaptive-icon safe zone (center 54,54,
        radius 33). White needle family on the blue gradient, matching the
        translated app name (البوصلة / قطبنما / 指南针…). Bilaterally
        symmetric so it renders identically in RTL locales.
    -->
    <!-- Outer ring -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 53.99,28 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <!-- North needle (white, bold) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,33 L61.5,54 L54,46.5 L46.5,54 Z" />

    <!-- South needle (light blue, subtle) -->
    <path
        android:fillColor="#FFB3E5FC"
        android:pathData="M54,75 L46.5,54 L54,61.5 L61.5,54 Z" />

    <!-- West tick -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M33,51.5 h6 v5 h-6 Z" />

    <!-- East tick -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M69,51.5 h6 v5 h-6 Z" />

    <!-- Center hub -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52,51.5 h4 v5 h-4 Z" />
